## Generates TypeScript contracts (`frontend/src/arvo.gen.ts`) from Mo compiler-derived
## `Arvo.Inertia.PageContract` JSON schemas + optional `/openapi.json`, and verifies page existence.
module Codegen
expose schema_to_ts, generate_ts, missing_page_components
use Arvo.Inertia
use Json

fn ident_char?(ch: Char, first?: Bool) : Bool
  if first?
    ch.ascii_letter? or ch == '_' or ch == '$'
  else
    ch.ascii_letter? or ch.ascii_digit? or ch == '_' or ch == '$'
  end
end

fn valid_ts_ident?(name: Text) : Bool
  return false if name.empty?
  for (idx, ch) in name.chars.enumerate
    if not ident_char?(ch, idx == 0)
      return false
    end
  end
  true
end

fn format_prop_key(name: Text) : Text
  if valid_ts_ident?(name): name else: Json.String(name).to_text
end

fn safe_component_ident(component: Text) : Text
  var chars = []
  var cap_next? = true
  for ch in component.chars
    if ch.ascii_letter? or ch.ascii_digit?
      chars = chars.append(if cap_next?: ch.ascii_uppercase else: ch)
      cap_next? = false
    else
      cap_next? = true
    end
  end
  out = Text.from_chars(chars)
  if out.empty? or (out.chars.first or '_').ascii_digit?: "Page#{out}" else: out
end

fn object_props_ts(props_map: Map(Text, Json)) : Text
  return "{}" if props_map.empty?
  ordered = props_map.entries.sort_by(fn(p) p.0 end)
  fields = ordered.map(fn(p) "#{format_prop_key(p.0)}: #{schema_to_ts(p.1)}" end)
  "{ #{fields.join("; ")} }"
end

## Translates a Mo `Json.schema[T]()` node into its TypeScript type representation (Spec 5.1).
fn schema_to_ts(schema: Json) : Text
  if schema.path("enum") is Some(Json.Array(enum_items))
    lits = enum_items.map(fn(item) item.to_text end)
    return lits.join(" | ") if not lits.empty?
  end

  if schema.path("anyOf") is Some(Json.Array(alts))
    parts = alts.map(schema_to_ts)
    return parts.join(" | ") if not parts.empty?
  end

  case schema.text_at("type")
    Some("boolean"): "boolean"
    Some("integer") | Some("number"): "number"
    Some("string"): "string"
    Some("null"): "null"
    Some("array"):
      if schema.path("prefixItems") is Some(Json.Array(tuple_items))
        "[#{tuple_items.map(schema_to_ts).join(", ")}]"
      else if schema.get("items") is Some(item_schema)
        inner = schema_to_ts(item_schema)
        if inner.contains?(" | ") or inner.contains?(" & ")
          "(#{inner})[]"
        else
          "#{inner}[]"
        end
      else
        "unknown[]"
      end
    Some("object"):
      case schema.get("properties")
        Some(Json.Object(props_map)): object_props_ts(props_map)
        None | Some(_):
          case schema.get("additionalProperties")
            Some(val_schema): "Record<string, #{schema_to_ts(val_schema)}>"
            None: "Record<string, unknown>"
          end
      end
    Some(_) | None: "unknown"
  end
end

fn render_interface_body(schema: Json, indent: Text) : List(Text)
  case schema.get("properties")
    Some(Json.Object(props_map)):
      ordered = props_map.entries.sort_by(fn(p) p.0 end)
      ordered.map(fn(p) "#{indent}#{format_prop_key(p.0)}: #{schema_to_ts(p.1)};" end)
    None | Some(_): []
  end
end

fn merge_shared_properties(contracts: List(Inertia.PageContract)) : Json
  var merged = {}
  for c in contracts
    if c.shared_schema.get("properties") is Some(Json.Object(props))
      for (k, v) in props
        merged = merged.set(k, v)
      end
    end
  end
  Json.Object({"type": Json.String("object"), "properties": Json.Object(merged)})
end

fn collect_openapi_endpoints(openapi: Option(Json)) : List(Text)
  doc = case openapi
    Some(d): d
    None: return []
  end
  paths_obj = case doc.get("paths")
    Some(Json.Object(pm)): pm
    None | Some(_): return []
  end
  var out = []
  for (p, item) in paths_obj.entries.sort_by(fn(pair) pair.0 end)
    if item is Json.Object(methods)
      for (m, _) in methods.entries.sort_by(fn(pair) pair.0 end)
        out = out.append("#{m.ascii_uppercase} #{p}")
      end
    end
  end
  out
end

## Generates the complete deterministic TypeScript module `frontend/src/arvo.gen.ts`.
fn generate_ts(contracts: List(Inertia.PageContract), openapi: Option(Json)) : Text
  sorted = contracts.sort_by(fn(c) c.component end)
  var lines = [
    "// Generated by `arvo contracts` from Mo Json.schema[T](). Do not edit by hand.",
    ""
  ]

  shared_body = render_interface_body(merge_shared_properties(sorted), "  ")
  lines = lines.append("export interface SharedProps {")
  lines = lines.concat(shared_body)
  lines = lines.append("}").append("")

  var map_entries = []
  for c in sorted
    ident = safe_component_ident(c.component)
    props_name = "#{ident}Props"
    page_props_name = "#{ident}PageProps"
    body_lines = render_interface_body(c.props_schema, "  ")
    lines = lines.append("export interface #{props_name} {")
    lines = lines.concat(body_lines)
    lines = lines.append("}").append("")
    lines = lines.append("export type #{page_props_name} = #{props_name} & SharedProps;").append("")
    map_entries = map_entries.append("  #{format_prop_key(c.component)}: #{page_props_name};")
  end

  lines = lines.append("export interface ArvoPagePropsMap {")
  lines = lines.concat(map_entries)
  lines = lines.append("}").append("")
  lines = lines.append("export type ArvoPageName = keyof ArvoPagePropsMap;").append("")

  endpoints = collect_openapi_endpoints(openapi)
  if not endpoints.empty?
    ep_union = endpoints.map(fn(ep) "  | #{Json.String(ep).to_text}" end)
    lines = lines.append("export type ArvoApiEndpoint =")
    lines = lines.concat(ep_union)
    lines = lines.append(";").append("")
  end

  "#{lines.join("\n")}\n"
end

## Checks that every `PageContract.component` resolves to `<pages_dir>/<component>.tsx`.
fn missing_page_components(files: ReadFiles, pages_dir: Text, contracts: List(Inertia.PageContract)) : List(
  Text
)
  base = pages_dir.drop_suffix("/") or pages_dir
  var missing = []
  for c in contracts
    expected_path = "#{base}/#{c.component}.tsx"
    if not files.exists?(expected_path)
      missing = missing.append(expected_path)
    end
  end
  missing.sort
end

struct ProbeEnumA
  id: Int
end

enum ProbeStatus
  Pending
  Paid(amount: Decimal)
end

struct ProbeProps
  ok?: Bool
  count: Int
  price: Decimal
  when: Time
  note: Option(Text)
  tags: List(Text)
  counts: Map(Text, Int)
  pair: (Text, Int)
  status: ProbeStatus
  extra: Json
end

struct ProbeShared
  viewer: Option(ProbeEnumA)
end

test "Codegen translates all Mo Json.schema types into deterministic TypeScript and checks page components"
  c_login = Inertia.page_contract[ProbeShared, ProbeShared](
    "Auth/Login",
    ["/login"],
    Inertia.Of,
    Inertia.Of
  )
  c_slug = Inertia.page_contract[ProbeShared, ProbeShared](
    "bill-item",
    ["/items"],
    Inertia.Of,
    Inertia.Of
  )
  c_home = Inertia.page_contract[ProbeProps, ProbeShared]("Home", ["/"], Inertia.Of, Inertia.Of)
  oa = Json.Object({
    "paths": Json.Object({
      "/": Json.Object({"get": Json.Object({})}),
      "/bills/{id}/pay": Json.Object({"post": Json.Object({})})
    })
  })

  ts = generate_ts([c_home, c_login, c_slug], Some(oa))
  assert ts.contains?("export interface SharedProps {")
  assert ts.contains?("viewer: { id: number } | null;")
  assert ts.contains?("export interface AuthLoginProps {")
  assert ts.contains?("export interface BillItemProps {")
  assert ts.contains?("export interface HomeProps {")
  assert ts.contains?("\"ok?\": boolean;")
  assert ts.contains?("count: number;")
  assert ts.contains?("price: string;")
  assert ts.contains?("when: string;")
  assert ts.contains?("note: string | null;")
  assert ts.contains?("tags: string[];")
  assert ts.contains?("counts: Record<string, number>;")
  assert ts.contains?("pair: [string, number];")
  assert ts.contains?("extra: unknown;")
  assert ts.contains?("export type HomePageProps = HomeProps & SharedProps;")
  assert ts.contains?("  \"Auth/Login\": AuthLoginPageProps;")
  assert ts.contains?("  \"bill-item\": BillItemPageProps;")
  assert ts.contains?("  Home: HomePageProps;")
  assert ts.contains?("export type ArvoApiEndpoint =")
  assert ts.contains?("  | \"POST /bills/{id}/pay\"")
  assert format_prop_key("quoted\"\\name") == "\"quoted\\\"\\\\name\""
  assert safe_component_ident("123/Start") == "Page123Start"
  assert schema_to_ts(Json.Object({"enum": Json.Array([Json.String("a\nb\"c")])})) ==
    "\"a\\nb\\\"c\""

  assert schema_to_ts(
    Json.Object({
      "type": Json.String("object"),
      "properties": Json.Object({
        "_u": Json.Object({"type": Json.String("string")}),
        "$s": Json.Object({"type": Json.String("string")}),
        "a1_$": Json.Object({"type": Json.String("integer")}),
        "1bad": Json.Object({"type": Json.String("boolean")}),
        "": Json.Object({"type": Json.String("string")}),
        "bad-k": Json.Object({"type": Json.String("string")})
      })
    })
  ) ==
    "{ \"\": string; $s: string; \"1bad\": boolean; _u: string; a1_$: number; \"bad-k\": string }"

  assert schema_to_ts(Json.Object({"enum": Json.Array([])})) == "unknown"

  assert schema_to_ts(
    Json.Object({
      "type": Json.String("array"),
      "items": Json.Object({
        "anyOf": Json.Array([
          Json.Object({"type": Json.String("string")}),
          Json.Object({"type": Json.String("null")})
        ])
      })
    })
  ) ==
    "(string | null)[]"
  assert schema_to_ts(Json.Object({"type": Json.String("array")})) == "unknown[]"
  assert schema_to_ts(Json.Object({"type": Json.String("object")})) == "Record<string, unknown>"

  files = Files.in_memory({"frontend/src/pages/Home.tsx": "export default function Home() {}"})
    .read_only
  assert missing_page_components(files, "frontend/src/pages/", [c_home, c_login]) == [
    "frontend/src/pages/Auth/Login.tsx"
  ]
end
